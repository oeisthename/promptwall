FROM python:3.12-slim AS base

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Copy project files
COPY pyproject.toml README.md ./
COPY src ./src

# Install all optional dependencies to support ML and DLP out of the box in the container
RUN uv sync --all-extras --no-dev

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["promptwall", "serve", "--host", "0.0.0.0", "--port", "8000"]
