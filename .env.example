# Copy this file to .env and fill in real values. Never commit .env.

# --- API server ---
DATABASE_URL=sqlite:///./promptwall.db
# For production: DATABASE_URL=postgresql://user:password@localhost:5432/promptwall

PROMPTWALL_POLICY_DIR=./policies

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=promptwall-api

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
